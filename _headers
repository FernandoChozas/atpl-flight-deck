/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://ntfy.sh; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://ntfy.sh https://api.open-meteo.com https://aviationweather.gov; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
